# Copy this file to .env, or run: npm run setup
# Never commit .env. Values below are examples, not working credentials.

# Application
PORT=5050
PUBLIC_BASE_URL=
ADMIN_TOKEN=

# The scheduler is off by default so cloning the repository cannot trigger a call.
ENABLE_SCHEDULER=false
CALL_CRON=0 20 * * *
TIME_ZONE=Asia/Shanghai
MAX_CALL_SECONDS=240
MAX_CONVERSATION_TURNS=6

# The consenting recipient in E.164 format, for example +8613800138000.
TARGET_PHONE_NUMBER=

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
VALIDATE_TWILIO_SIGNATURE=true
TWILIO_SPEECH_LANGUAGE=cmn-Hans-CN
TWILIO_SAY_LANGUAGE=zh-CN

# DeepSeek. Use an official key from platform.deepseek.com.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
