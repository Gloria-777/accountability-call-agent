# Application
PORT=5050
PUBLIC_BASE_URL=https://your-public-url.example.com
ADMIN_TOKEN=replace-with-a-long-random-string

# The scheduler is off by default so cloning the repository cannot trigger a call.
ENABLE_SCHEDULER=false
CALL_CRON=0 20 * * *
TIME_ZONE=Asia/Shanghai
MAX_CALL_SECONDS=240

# Your own number in E.164 format, for example +8613800138000.
TARGET_PHONE_NUMBER=

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
VALIDATE_TWILIO_SIGNATURE=true

# OpenAI Realtime SIP
OPENAI_API_KEY=
OPENAI_WEBHOOK_SECRET=
OPENAI_PROJECT_ID=proj_replace_me
OPENAI_REALTIME_MODEL=gpt-realtime-2.1-mini
OPENAI_VOICE=marin
