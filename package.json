{
  "name": "accountability-call-agent",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A reusable accountability phone agent powered by Twilio and the OpenAI Realtime SIP API.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gloria-777/accountability-call-agent.git"
  },
  "bugs": {
    "url": "https://github.com/Gloria-777/accountability-call-agent/issues"
  },
  "homepage": "https://github.com/Gloria-777/accountability-call-agent#readme",
  "keywords": [
    "openai",
    "realtime-api",
    "twilio",
    "voice-agent",
    "accountability"
  ],
  "scripts": {
    "setup": "node scripts/setup.js",
    "doctor": "node scripts/doctor.js",
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "node --test",
    "check": "node --check src/server.js && node --check src/realtime.js && node --check src/telephony.js && node --check scripts/setup.js && node --check scripts/doctor.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "node-cron": "^4.2.1",
    "openai": "^5.20.3",
    "twilio": "^5.10.4",
    "ws": "^8.18.3"
  },
  "devDependencies": {}
}
